# ClickHouse (durable candle store). compose.yaml creates this user; the URL below reaches its
# loopback port from processes run directly with Bun.
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_USER=dya
CLICKHOUSE_PASSWORD=local-dev-password
CLICKHOUSE_DATABASE=market
# Instead of CLICKHOUSE_PASSWORD, a file holding it; never set both.
# CLICKHOUSE_PASSWORD_FILE=/absolute/path/to/clickhouse_password

# Valkey/Redis 7.2+ (ephemeral live state and fan-out between ingest and API processes).
REDIS_URL=redis://127.0.0.1:16379

# Optional comma-separated venue symbols for the ingest process (e.g. `ingest okx`: OKB-USDT).
# Default: that venue's registry markets, including historical continuations.
MARKET_SYMBOLS=
# Per exchange venue (BINANCE, BYBIT, OKX, KUCOIN, GATE, MEXC, KRAKEN, SAFETRADE), all optional:
#   <VENUE>_REST_URL, <VENUE>_STREAM_URL, and <VENUE>_BUDGET (REST requests per minute; for
#   Binance, request weight per minute). Defaults: src/venues/*.ts and src/binance/venue.ts.
#   RHEA and INTENTS are read from the NEAR block feed and have no stream URL.
BINANCE_BUDGET=3000

# CoinGecko Demo API key for token metadata (`token-markets`). Empty: the keyless API.
COINGECKO_API_KEY=

# NEAR Intents Explorer partner key (key type "explorer"): lists 1Click swaps for the Intents
# history backfill and for `generate-registry.ts`. Empty: Intents markets start at the switch minute.
INTENTS_EXPLORER_JWT=

# FastNEAR key for neardata.xyz: the NEAR block feed (`near-feed`) and gap repair in the Rhea and
# Intents ingests. Empty: the free tier, which may not keep up with the chain.
FASTNEAR_API_KEY=
# NEARDATA_URL=https://mainnet.neardata.xyz

# Reviewed token metadata catalog of the DYA ID service, required by `token-markets`.
DYA_ID_CATALOG_URL=http://localhost:3000/api/near/metadata-catalog

# API
API_PORT=8080
# Processes sharing API_PORT via SO_REUSEPORT (Linux load-balances; other OSes may not).
API_WORKERS=1
# Comma-separated browser origins allowed for CORS and WebSocket upgrades.
CORS_ORIGINS=http://localhost:3100
# Trust this header only behind a proxy that strips client-supplied values; empty uses the socket peer.
CLIENT_IP_HEADER=
RATE_LIMIT_PER_MINUTE=1200

# Immutable candle URL revision; migrate the registry and run every API worker with the same value.
DATA_REVISION=1

# Loopback ports compose.yaml publishes.
DEV_CLICKHOUSE_PORT=18123
DEV_VALKEY_PORT=16379
DEV_API_PORT=18080
