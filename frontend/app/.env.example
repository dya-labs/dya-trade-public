# NEAR AI Cloud API key (https://cloud.near.ai) for the read-only Jev entry planner and Terminal chat; both stay unavailable without it.
# Chat runs on a confidential TEE model; Jev runs through the NEAR AI Cloud gateway.
NEAR_AI_API_KEY=

# Local Worker development reads this file (copied to .env.local) and overrides wrangler.jsonc vars.
# Leave blank for http://localhost:3100. Any non-local origin (e.g. https://app.example.com) must use HTTPS.
APP_ORIGIN=
# Optional; when set, must equal APP_ORIGIN's exact hostname (no scheme/port).
PASSKEY_RP_ID=

# Required on non-local origins: any non-empty password for the internal access gate.
# Browser login username: tester. Never prefix server values with VITE_ (Vite ships those to the browser).
INTERNAL_ACCESS_PASSWORD=

# Data API origin. Blank uses the local backend/data-api at http://127.0.0.1:8080.
# VITE_DATA_API_ORIGIN is built into the browser bundle; DATA_API_ORIGIN is read by the Worker (Jev).
VITE_DATA_API_ORIGIN=
DATA_API_ORIGIN=

# Wallet service origin (DYA ID), e.g. https://id.example.com.
DYA_ID_ORIGIN=http://localhost:3101
# Same server-only 32+ character value in Terminal and DYA ID on non-local origins.
DYA_SERVICE_SECRET=

# Public links in @dya/config, inlined at build time. Blank uses the local dev servers.
DYA_APP_URL=
DYA_ID_URL=
DYA_DOCS_URL=
