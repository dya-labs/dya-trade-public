// DYA ID Worker for local development. Origins come from vars here or from .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dya-id",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Workers Logs keep our structured console events (request.error with its request ID).
  // Invocation logs and traces are off: they record request URLs, and flow URLs carry bearer flow IDs.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:3101",
    "DYA_TERMINAL_ORIGIN": "http://localhost:3100",
    "PASSKEY_RP_ID": "localhost",
    "TERMINAL_STORAGE": "d1",
    "DYA_ID_D1_QUERY_PROFILE": "paid"
  },
  "d1_databases": [
    {
      "binding": "DYA_ID_DB",
      "database_name": "dya-id",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../backend/id/d1-migrations",
      "remote": false
    }
  ]
}
