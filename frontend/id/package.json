{
  "name": "id",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DYA_ID_LOCAL_D1=1 bun --bun vite dev --port 3101",
    "build": "node ../../packages/ui/scripts/build-brand-assets.mjs && bun --bun vite build",
    "start": "bun --bun wrangler dev --config dist/server/wrangler.json --port 3101",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint . --max-warnings=0",
    "db:migrate": "bun ../../backend/id/scripts/migrate.mjs",
    "dev:vinext": "bun --bun vite dev --port 3102",
    "build:vinext": "node ../../packages/ui/scripts/build-brand-assets.mjs && bun --bun vite build",
    "dev:sqlite": "TERMINAL_STORAGE=sqlite bun --bun next dev -p 3101",
    "build:d1:local": "node ../../packages/ui/scripts/build-brand-assets.mjs && DYA_ID_LOCAL_D1=1 bun --bun vite build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@next/env": "16.4.3",
    "@simplewebauthn/browser": "14.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "@dya/id-service": "*",
    "@dya/wallet-contracts": "*",
    "@dya/ui": "*",
    "@dya/wallet-ui": "*",
    "@tanstack/react-query": "5.103.2",
    "@dya/config": "*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "1.0.1",
    "@vitejs/plugin-rsc": "0.5.37",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.5",
    "wrangler": "4.147.0"
  },
  "type": "module"
