{
  "name": "dya-trade",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "frontend/app",
    "frontend/id",
    "frontend/docs",
    "backend/id",
    "packages/wallet-contracts",
    "packages/wallet-sdk",
    "packages/wallet-react",
    "packages/ui",
    "packages/wallet-ui",
    "packages/config",
    "packages/catalog"
  ],
  "scripts": {
    "build:brand": "node packages/ui/scripts/build-brand-assets.mjs",
    "dev": "bun run --filter app dev",
    "build": "bun run --filter app build",
    "start": "bun run --filter app start",
    "test": "bun run --filter app test",
    "typecheck": "bun run --filter app typecheck",
    "lint": "bun run --filter app lint",
    "db:migrate": "bun run --filter id db:migrate",
    "dev:id": "bun run --filter id dev",
    "build:id": "bun run --filter id build",
    "typecheck:id": "bun run --filter id typecheck",
    "lint:id": "bun run --filter id lint",
    "typecheck:ui": "bun run --filter @dya/ui typecheck",
    "dev:id:d1": "bun run --filter id dev",
    "db:migrate:id:d1:local": "bun --bun wrangler d1 migrations apply dya-id-local --local --config frontend/id/wrangler.local.jsonc --persist-to frontend/id/.wrangler/state",
    "db:init:id:d1:local": "bun backend/id/scripts/init-d1.mjs",
    "test:id:d1": "vitest run --config backend/id/vitest.d1.config.ts",
    "build:id:d1:local": "bun run --filter id build:d1:local",
    "typecheck:id:d1": "bun --bun tsc -p backend/id/tsconfig.d1.json",
    "dev:docs": "bun run --filter @dya/docs dev",
    "build:docs": "bun run --filter @dya/docs build",
    "typecheck:docs": "bun run --filter @dya/docs typecheck"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "fflate": "0.7.5",
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "body-parser": "2.4.0",
    "ip-address": "10.7.4",
    "toml": "5.0.1",
    "follow-redirects": "1.16.2",
    "systeminformation": "5.33.16",
    "@hono/node-server": "2.1.6",
    "glob": "14.0.2",
    "katex": "0.18.2",
    "qs": "6.16.1",
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.103.2",
    "@types/bun": "1.4.3",
    "jsdom": "26.1.0"
  }
}
